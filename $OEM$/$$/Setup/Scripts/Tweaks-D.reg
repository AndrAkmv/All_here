[-HKEY_CLASSES_ROOT\Folder\shell\pintohome]
;Удалить "Закрепить на панели быстрого доступа" из контекстного меню папок

;Настройка визуальных эффектов Рабочего стола
[HKEY_CURRENT_USER\Control Panel\Desktop]
;Увеличить частоту мерцания курсора
"CursorBlinkRate"="200"
;Отключить сглаживание неровностей экранных шрифтов
"FontSmoothing"="0"
;Выключить сглаживание ClearType
"FontSmoothingType"=dword:00000000

;Дополнительная настройка внешнего вида
[HKEY_CURRENT_USER\Control Panel\Desktop\WindowMetrics]
;Показывать полностью имена длинных файлов в Проводнике
"IconTitleWrap"="0"
;Отключить анимацию окон при свертывании и развертывании
"MinAnimate"="0"

;Установка списка языков и параметров конфиденциальности
[HKEY_CURRENT_USER\Control Panel\International\User Profile]
;Не предоставлять веб-сайтам доступ к моему списку языков
"HttpAcceptLanguageOptOut"=dword:00000001
;Сортировать языки ввода в порядке: английский, русский
"Languages"=hex(7):65,00,6e,00,2d,00,55,00,53,00,00,00,72,00,75,00,00,00,00,00

[HKEY_CURRENT_USER\Control Panel\Keyboard]
;Убрать задержку повтора при зажатии клавиши
"KeyboardDelay"="0"

[HKEY_CURRENT_USER\Control Panel\Quick Actions\Control Center\QuickActionsStateCapture]
;Установка нужных плиток на панели Центра уведомлений
"Sliders"="Sliders"
"Toggles"="Toggles,Microsoft.QuickAction.BlueLightReduction:false,Microsoft.QuickAction.QuietHours:false,Microsoft.QuickAction.Bluetooth:false,Microsoft.QuickAction.WiFi:false"

[HKEY_CURRENT_USER\Control Panel\Quick Actions\Control Center\Unpinned]
;Выбор используемых плиток из списка незакреплённых
"Microsoft.QuickAction.AirplaneMode"=hex(0):
"Microsoft.QuickAction.AllSettings"=hex(0):
"Microsoft.QuickAction.AvailableNetworks"=hex(0):
"Microsoft.QuickAction.BatterySaver"=hex(0):
