Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\AllFilesystemObjects\shellex\ContextMenuHandlers\CopyTo]
;Добавить пункт "Копировать в папку..." в контекстное меню файлов
@="{C2FBB630-2971-11d1-A18C-00C04FD75D13}"

[HKEY_CLASSES_ROOT\AllFilesystemObjects\shellex\ContextMenuHandlers\MoveTo]
;Добавить пункт "Переместить в папку..." в контекстное меню файлов
@="{C2FBB631-2971-11d1-A18C-00C04FD75D13}"

;Настройка визуальных эффектов Рабочего стола
[HKEY_CURRENT_USER\Control Panel\Desktop]
;Увеличить частоту мерцания курсора
"CursorBlinkRate"="200"
;Отключить сглаживание неровностей экранных шрифтов
"FontSmoothing"="0"
;Выключить сглаживание ClearType
"FontSmoothingType"=dword:00000000

;Дополнительная настройка внешнего вида
[HKEY_CURRENT_USER\Control Panel\Desktop\WindowMetrics]
;Показывать полностью имена длинных файлов в Проводнике
"IconTitleWrap"="0"
;Отключить анимацию окон при свертывании и развертывании
"MinAnimate"="0"

;Установка списка языков и параметров конфиденциальности
[HKEY_CURRENT_USER\Control Panel\International\User Profile]
;Не предоставлять веб-сайтам доступ к моему списку языков
"HttpAcceptLanguageOptOut"=dword:00000001
;Сортировать языки ввода в порядке: английский, русский
"Languages"=hex(7):65,00,6e,00,2d,00,55,00,53,00,00,00,72,00,75,00,00,00,00,00

[HKEY_CURRENT_USER\Control Panel\Keyboard]
;Убрать задержку повтора при зажатии клавиши
"KeyboardDelay"="0"

[HKEY_CURRENT_USER\Environment]
;Использовать %SYSTEMROOT%\Temp как временную папку для всех пользователей
"TEMP"=-
"TMP"=-

[HKEY_CURRENT_USER\Keyboard Layout\Preload]
;Установить английский язык по умолчанию, добавить русский язык
"1"="00000409"
"2"="00000419"

[HKEY_CURRENT_USER\Keyboard Layout\Toggle]
;Установить Ctrl+Shift для переключение между языками ввода
"Hotkey"="2"
"Language Hotkey"="2"
"Layout Hotkey"="3"

[HKEY_CURRENT_USER\Software\Microsoft\CTF\SortOrder\Language]
;Сортировать языки ввода в порядке: английский, русский
"00000000"="00000409"
"00000001"="00000419"

[HKEY_CURRENT_USER\Software\Microsoft\FTP]
;Запретить просмотр FTP-папок (за пределами Internet Explorer)
"Use Web Based FTP"="yes"

;Настройка персонализации ввода
[HKEY_CURRENT_USER\Software\Microsoft\InputPersonalization]
;Ограничить сбор данных рукописного ввода
"RestrictImplicitInkCollection"=dword:00000001
;Ограничить сбор данных набора текста
"RestrictImplicitTextCollection"=dword:00000001

;Параметры проверки цифровой подписи программ
[HKEY_CURRENT_USER\Software\Microsoft\Internet Explorer\Download]
;Не проверять цифровую подпись загружаемых программ
"CheckExeSignatures"="no"
;Запускать программы с непроверенной цифровой подписью
"RunInvalidSignatures"=dword:00000001

;Основная настройка Internet Explorer 11
[HKEY_CURRENT_USER\Software\Microsoft\Internet Explorer\Main]
;Открывать плитки Internet Explorer на Рабочем столе
"ApplicationTileImmersiveActivation"=dword:00000000
;Не предлагать использовать по умолчанию
"Check_Associations"="no"
;Запретить персонализацию при первом запуске
"DisableFirstRunCustomize"=dword:00000001
;Отключить уведомление по окончании загрузки
"NotifyDownloadComplete"="no"
;Использовать новую вкладку при запуске
"Start Page"="about:Tabs"

[HKEY_CURRENT_USER\Software\Microsoft\Internet Explorer\Main\FeatureControl\FEATURE_LOCALMACHINE_LOCKDOWN]
;Разрешить запуск активного содержимого файлов на моем компьютере
"iexplore.exe"=dword:00000000

[HKEY_CURRENT_USER\Software\Microsoft\Internet Explorer\Main\FeatureControl\FEATURE_LOCALMACHINE_LOCKDOWN\Settings]
;Разрешить запуск активного содержимого компакт-дисков на моем компьютере
"LOCALMACHINE_CD_UNLOCK"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Internet Explorer\MINIE]
;Показывать вкладки в отдельной строке
"ShowTabsBelowAddressBar"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Internet Explorer\PhishingFilter]
;Выключить фильтр SmartScreen для Internet Explorer
"EnabledV9"=dword:00000000

[HKEY_CURRENT_USER\Software\Microsoft\Internet Explorer\PrefetchPrerender]
;Не загружать сайты и содержимое в фоновом режиме
"Enabled"=dword:00000000

[HKEY_CURRENT_USER\Software\Microsoft\Internet Explorer\TabbedBrowsing]
;При открытии новой вкладки открывать домашнюю страницу
"NewTabPageShow"=dword:00000001

;Настройка Windows Media Player 12
[HKEY_CURRENT_USER\Software\Microsoft\MediaPlayer\Preferences]
;Принять лицензионное соглашение
"AcceptedPrivacyStatement"=dword:00000001
;Не добавлять файлы видео, найденные в библиотеке изображений
"AddVideosFromPicturesLibrary"=dword:00000000
;Отключить автоматическое добавление музыки в библиотеку
"AutoAddMusicToLibrary"=dword:00000000
;Не удалять файлы с компьютера при удалении из библиотеки
"DeleteRemovesFromComputer"=dword:00000000
;Запретить автоматическую проверку лицензий защищённых файлов
"DisableLicenseRefresh"=dword:00000001
;Отметить, что проигрыватель уже запускался
"FirstRun"=dword:00000000
;Не сохранять оценки в файлах мультимедиа
"FlushRatingsToFiles"=dword:00000000
;Не спрашивать о воспроизведении с веб-страницы
"HTMLViewAsk"=dword:00000000
;Не показывать сведения о мультимедиа из Интернета и не обновлять файлы
"MetadataRetrieval"=dword:00000000
;Отключить загрузку лицензий на использование файлов мультимедиа
"SilentAcquisition"=dword:00000000
;Не устанавливать автоматически часы на устройсвтах
"SilentDRMConfiguration"=dword:00000000
;Увеличить время запроса автоматического обновления проигрывателя
"UpgradeCheckFrequency"=dword:00000002
;Не отправлять данные об использовании проигрывателя
"UsageTracking"=dword:00000000

[HKEY_CURRENT_USER\Software\Microsoft\Office\15.0\Common\General]
;Отметить показанным начальный диалог Office 2013
"ShownFirstRunOptin"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Office\15.0\FirstRun]
;Пропустить мастер подключения учётной записи Майкрософт
"BootedRTM"=dword:00000001

;Настройка Проводника
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer]
;Отображать все значки в области уведомлений
"EnableAutoTray"=dword:00000000
;He дoбaвлять "- Ярлык" для coздaвaeмыx яpлыкoв
"link"=hex:00,00,00,00

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Accent]
;Отображать фон Рабочего стола на Начальном экране
"MotionAccentId_v1.00"=dword:000000db

;Расширенная настройка Проводника
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
;Показывать скрытые файлы, папки и диски
"Hidden"=dword:00000001
;Показывать пустые диски в папке "Компьютер"
"HideDrivesWithNoMedia"=dword:00000000
;Показывать расширения для зарегистрированных типов файлов
"HideFileExt"=dword:00000000
;Показывать конфликты слияния папок
"HideMergeConflicts"=dword:00000000
;Не отображать папку "Избранное"
"NavPaneShowFavorites"=dword:00000000
;Не использовать мастер общего доступа
"SharingWizardOn"=dword:00000000
;Не выделять недавно установленные программы
"Start_NotifyNewApps"=dword:00000000
;Не показывать приложения Магазина Windows на панели задач
"StoreAppsOnTaskbar"=dword:00000000
;Отключить скольжение кнопок Панели задач
"TaskbarAnimations"=dword:00000000
;Не группировать кнопки на Панели задач
"TaskbarGlomLevel"=dword:00000002
;Использовать маленькие значки на Панели задач
"TaskbarSmallIcons"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\AutoComplete]
;Использовать встроенное автозаполнение
"Append Completion"="yes"

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers]
;Запретить автозапуск для всех носителей и устройств
"DisableAutoplay"=dword:00000001

[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\EventHandlersDefaultSelection]
[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\AutoplayHandlers\UserChosenExecuteHandlers]
;Сбросить настройки автозапуска для всех носителей и устройств

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\CIDOpen\Modules\GlobalSettings\Sizer]
;Скрыть область навигации в диалоге "Открыть..."
"PageSpaceControlSizer"=hex:a0,00,00,00,00,00,00,00,00,00,00,00,9b,02,00,00

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\CIDSave\Modules\GlobalSettings\Sizer]
;Скрыть область навигации в диалоге "Сохранить как..."
"PageSpaceControlSizer"=hex:a0,00,00,00,00,00,00,00,00,00,00,00,9b,02,00,00

;Настройка Панели управления
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\ControlPanel]
;Показывать крупные значки
"AllItemsIconView"=dword:00000000
;Показывать все элементы
"StartupPage"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\DontShowMeThisDialogAgain]
;Не показывать запрос перед удалением программ
"{948e51fb-0a48-44f0-86ac-33c36def540c}"="NO"

;Добавление значков на Рабочий стол
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\HideDesktopIcons\NewStartPanel]
;Отображать Компьютер на Рабочем столе
"{20D04FE0-3AEA-1069-A2D8-08002B30309D}"=dword:00000000
;Отображать %UserName% на Рабочем столе
"{59031a47-3f72-44a7-89c5-5595fe6b30ee}"=dword:00000000

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Modules\GlobalSettings\Sizer]
;Скрыть область навигации в папках
"PageSpaceControlSizer"=hex:a0,00,00,00,00,00,00,00,00,00,00,00,45,03,00,00

;Настройка Начального экрана
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\StartPage]
;Открывать представление "Приложения" на Начальном экране
"MakeAllAppsDefault"=dword:00000001
;Показывать Начальный экран при нажатии клавиши Windows
"MonitorOverride"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Taskband]
;Изъять все программы из Панели задач
"Favorites"=hex:ff
"FavoritesResolve"=-

;Настройка действий для углов
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ImmersiveShell\EdgeUi]
;Запретить показывать последние приложения щелчке на левый верхний угол
"DisableTLCorner"=dword:00000001
;Запретить показывать чудо-кнопки при наведении на правый верхний угол
"DisableTRCorner"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ImmersiveShell\Grid]
;Сортировать по частоте использования в представлении Приложения
"LauncherSortOption"=dword:00000002

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ImmersiveShell\Switcher]
;Запретить переключение между последними приложениями Метро
"BackstackEnabled"=dword:00000000
;Оставить режим показа приложений Метро при касании левого края
"BackstackMode"=dword:00000001

;Настройка параметров безопасности браузера
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Internet Settings]
;Запретить встроенную проверку подлинности Windows
"EnableNegotiate"=dword:00000000
;Отключить предупреждение о несоответствии адреса сертификата
"WarnonBadCertRecving"=dword:00000000
;Отключить предупреждение о переходе в локальную зону
"WarnOnIntranet"=dword:00000000
;Отключить предупреждение о перенаправления публикаций
"WarnOnPostRedirect"=dword:00000000

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Policies\Attachments]
;Отключить предупреждение при открытии файлов, загруженных из Интернета
"SaveZoneInformation"=dword:00000001

;Дополнительная настройка Проводника
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer]
;Убрать значок "Центр поддержки" из области уведомлений
"HideSCAHealth"=dword:00000001
;Отключить встроенные средства записи компакт-дисков
"NoCDBurning"=dword:00000001
;Отключить проверку свободного места на диске
"NoLowDiskSpaceChecks"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows NT\CurrentVersion\MSDT]
;Запретить начинать устранение неполадок сразу после запуска
"AllowSkipFirstPage"=dword:00000000

[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.bmp\ShellNew]
;Удалить из контекстного меню Создать - Точечный рисунок

[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.contact\ShellNew]
;Удалить из контекстного меню Создать - Контакт

[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.rtf\ShellNew]
;Удалить из контекстного меню Создать - Документ RTF

[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.zip\CompressedFolder\ShellNew]
;Удалить из контекстного меню Создать - Сжатая ZIP-папка

[-HKEY_LOCAL_MACHINE\SOFTWARE\Classes\SystemFileAssociations\Directory.Audio\shellex\ContextMenuHandlers\WMPShopMusic]
;Удалить из контекстного меню Библиотеки (Аудио) - Поиск музыки в Интернете

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\SQMClient\Windows]
;Не принимать участие в Программе улучшения качества ПО
"CEIPEnable"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Device Metadata]
;Автоматически получать приложения и информацию для устройств
"PreventDeviceMetadataFromNetwork"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\DeviceSetup]
;Скачивать драйверы для новых устройств даже через лимитные подключения
"CostedNetworkPolicy"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\DriverSearching]
;Всегда устанавливать драйверы из Центра обновления Windows
"SearchOrderConfig"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\EOSNotify]
;Больше не напоминать об окончании срока поддержки
"DiscontinueEOS"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer]
;Выключить фильтр SmartScreen для приложений и файлов
"SmartScreenEnabled"="Off"

[-HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\RemoteComputer\NameSpace\{863aa9fd-42df-457b-8e4d-0de1b8015c60}]
;Не сканировать сеть на наличие сетевых принтеров

;Настройка выдачи уведомлений о вносимых изменениях
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System]
;Запускать программы от имени Администратора
"ConsentPromptBehaviorAdmin"=dword:00000000
;Отключить Контроль учётных записей (UAC)
"EnableLUA"=dword:00000000
;Не использовать защищённый Рабочий стол
"PromptOnSecureDesktop"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update]
;Не проверять наличие обновлений (не рекомендуется)
"AcceleratedInstallRequired"=-
"AUOptions"=dword:00000001
"CachedAUOptions"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\ScheduledDiagnostics]
;Отключить автоматический поиск распространённых неполадок 
"EnabledExecution"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\Windows Error Reporting]
;Не проверять наличие новых решений для отчётов о проблемах
"Disabled"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\AppCompatFlags\AIT]
;Не разрешать использовать Телеметрию для приложений
"AITEnable"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\SPP\Clients]
;Не восстанавливать параметры системы
"{09F7EDC5-294E-4180-AF6A-FB0E6A0E9513}"=-

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\SystemRestore]
;Отключить восстановление системы на всех дисках
"RPSessionInterval"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\MRT]
;Не предлагать обновления для Средства удаления вредоносных программ
"DontOfferThroughWUAU"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\Explorer]
;Не предлагать найти приложение в Магазине
"NoUseStoreOpenWith"=dword:00000001

;Поведение в случае отказа сисемы (BSOD)
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\CrashControl]
;Не выполнять автоматическую перезагрузку
"AutoReboot"=dword:00000000
;Не записывать отладочную информацию
"CrashDumpEnabled"=dword:00000000

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Power]
;Отключить режим Гибернации
"HibernateEnabled"=dword:00000000

;Установка параметров удалённого доступа
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Remote Assistance]
;Запретить удалённое управление этим компьютером
"fAllowFullControl"=dword:00000000
;Запретить подключения удалённого помощника к этому компьютеру
"fAllowToGetHelp"=dword:00000000

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management]
;Отключить файл подкачки приложений Магазина Windows
"SwapfileControl"=dword:00000000

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\CSC]
;Отключить драйвер автономных файлов
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\CscService]
;Отключить службу автономных файлов
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\DiagTrack]
;Отключить службу диагностического отслеживания
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\HomeGroupProvider]
;Отключить службу Поставщик домашней группы
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\IKEEXT]
;Отключить службу модулей ключей IPsec
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\iphlpsvc]
;Отключить вспомогательную службу IP
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\lanmanserver\Parameters]
;Отключить стандартные административные общие ресурсы (C$ и т.д.)
"AutoShareWks"=dword:00000000

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\luafv]
;Отключить драйвер виртуализации Контроля учетных записей
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\MpsSvc]
;Отключить службу Брандмауэр Windows
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\NcaSvc]
;Отключить службу Помощник по подключению к сети
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\NcbService]
;Отключить службу Посредник подключений к сети (Магазин)
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\PolicyAgent]
;Отключить службу Агент политики IPsec
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\SharedAccess\Parameters\FirewallPolicy\DomainProfile]
;Отключить доменный профиль Брандмауэра Windows
"EnableFirewall"=dword:00000000

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\SharedAccess\Parameters\FirewallPolicy\PublicProfile]
;Отключить общий профиль Брандмауэра Windows
"EnableFirewall"=dword:00000000

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\SharedAccess\Parameters\FirewallPolicy\StandardProfile]
;Отключить частный профиль Брандмауэра Windows
"EnableFirewall"=dword:00000000

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\ShellHWDetection]
;Отключить службу определения оборудования оболочки (Автозапуск)
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\SysMain]
;Отключить службу Superfetch
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\TabletInputService]
;Отключить службу ввода планшетного ПК
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\W32Time]
;Отключить службу времени Windows
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\W32Time\Parameters]
;Не выполнять синхронизацию с сервером времени в Интернете
"Type"="NoSync"

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\WinDefend]
;Отключить службу Защитник Windows
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\wscsvc]
;Отключить службу Центр обеспечения безопасности
"Start"=dword:00000004
